generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider     = "mysql"
  relationMode = "prisma"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  phone         String    @default("")
  website       String    @default("")

  name     String?
  image    String?
  password String?
  role     ROLE    @default(MANAGER)
  access   ACCESS  @default(USER)

  twoFactorSecret     String?
  tempTwoFactorSecret String?
  twoFactorEnabled    Boolean @default(false)

  createdByAdmin Boolean   @default(false)
  isActive       Boolean   @default(true)
  deactivatedAt  DateTime?

  // Sales-person webhook: receives sales-person events (e.g. lead_assigned)
  webhookUrl String?

  // Stripe
  stripeCustomerId           String?
  stripeSubscriptionId       String?
  stripePaymentMethodId      String?
  stripePriceId              String?
  plan                       PLAN?
  stripeSubscriptionStatus   String?
  stripeSubscriptionCancelAt DateTime?
  stripeCurrentPeriodEnd     DateTime?
  stripeSubscriptionTerm     PLAN_TERM?
  planIsActive               Boolean    @default(false)

  //razorpay
  razorpayCustomerId           String?    @unique
  razorpaySubscriptionEndDate  DateTime?
  razorpaySubscriptionCancelAt DateTime?
  razorpayPlanPriceId          String?
  razorpayPlanPeriod           PLAN_TERM?
  razorpaySubscriptionId       String?    @unique
  razorpaySubscriptionStatus   String?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations

  agencyId      String?
  Agency        User?   @relation("AgencyToMembers", fields: [agencyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  AgencyMembers User[]  @relation("AgencyToMembers")

  // sales agent (business relation)
  businessId String?
  Business   Business? @relation("BusinessSalesAgents", fields: [businessId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  ownerBusinessId String?
  OwnerBusiness   Business? @relation("BusinessOwner", fields: [ownerBusinessId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  Config Config?

  Account         Account[]
  Session         Session[]
  AgencyLeads     Lead[]    @relation("AgencyToLead")
  SalesAgentLeads Lead[]    @relation("SalesAgentToLead")

  SalesAgentMeetings Meeting[]  @relation("SalesAgentToMeeting")
  AgencyMeetings     Meeting[]  @relation("AgencyToMeeting")
  AgencyCalls        LeadCall[] @relation("AgencyToLeadCall")
  AgentCalls         LeadCall[] @relation("SalesAgentToLeadCall")

  agencyApiKeys  ApiKey[] @relation("AgencyToApiKey")
  managerApiKeys ApiKey[] @relation("ManagerToApiKey")

  Campaigns            Campaign[]
  CampaignLeads        CampaignLead[]
  NumberPools          NumberPool[]
  PoolPhoneNumbers     PoolPhoneNumber[]
  Assistant            Assistant[]
  Pipelines            Pipeline[]
  Opportunities        Opportunity[]
  Stages               Stage[]
  AgencyCompanies         Company[]      @relation("AgencyToCompany")
  SalesAgentCompanies     Company[]      @relation("SalesAgentToCompany")
  SalesAgentOpportunities Opportunity[]  @relation("SalesAgentToOpportunity")
  QuotesCreated           Quote[]        @relation("QuoteCreatedBy")
  ContractsCreated        Contract[]     @relation("ContractCreatedBy")
  AgencyCustomObjects     CustomObject[] @relation("AgencyToCustomObject")
  AgencyAssociationDefinitions AssociationDefinition[] @relation("AgencyToAssociationDefinition")
  AgencyCustomMenuLinks   CustomMenuLink[] @relation("AgencyToCustomMenuLink")
  Events               Event[]
  AgentFollowUps       FollowUp[]            @relation("SalesAgentToFollowUp")
  AgencyFollowUps      FollowUp[]            @relation("AgencyToFollowUp")
  ConversationMessages ConversationMessage[]
  Conversations        Conversation[]
  BaseAgentSessions    BaseAgentSession[]
  AgencyBusinesses     Business[]            @relation("BusinessAgency")
  ManagerBusinesses    BusinessManager[]
  preferenceId         String?
  PrimaryAgents        PrimaryAgent[]
  VoiceSessions        VoiceSession[]
  Automations          Automation[]
  AutomationEnrollments AutomationEnrollment[]
  Knowledgebases       Knowledgebase[]
  BaseAgentsAsAgency   BaseAgent[]

  @@index([agencyId])
  @@index([businessId])
  @@index([ownerBusinessId])
}

model ApiKey {
  id        String    @id @default(uuid())
  name      String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  lastUsed  DateTime?

  businessId String
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  agencyId String
  Agency   User   @relation("AgencyToApiKey", fields: [agencyId], references: [id], onDelete: Cascade)

  managerId String?
  Manager   User?   @relation("ManagerToApiKey", fields: [managerId], references: [id], onDelete: Cascade)

  @@index([agencyId])
  @@index([businessId])
  @@index([managerId])
}

model Assistant {
  id String @id @default(uuid())

  name        String
  description String @db.Text
  config      Json?

  // Relations
  agencyId String
  Agency   User   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  businessId String
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  Campaigns Campaign[]

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId])
  @@index([businessId])
}

model Config {
  id String @id @default(uuid())

  // White Label Configuration
  whiteLabel               Boolean @default(false)
  showCRM                  Boolean @default(true)
  showCampaign             Boolean @default(true)
  customDomain             String?
  customRootDomain         String?
  customRootDomainVerified Boolean @default(false)
  companyName              String  @default("")
  onlyLogo                 Boolean @default(false)
  companyLogo              String  @default("")
  primaryColor             String  @default("#000000")
  secondaryColor           String  @default("#ffffff")
  faviconUrl               String  @default("")
  title                    String  @default("")
  description              String? @db.Text

  // Nameserver-based wildcard domain support
  isWildcard            Boolean @default(false)
  wildcardSetupMethod   String? // 'nameservers' or 'dns'
  nameserversConfigured Boolean @default(false)

  // Database Configuration
  databaseUrl     String?
  migrationStatus MIGRATION_STATUS @default(PENDING)
  migratedAt      DateTime?

  // Relations 
  agencyId String @unique
  Agency   User   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Primary-DB registry: maps external webhook ids (IG user id, WA phone_number_id, …)
/// to the agency whose tenant DB holds the integration data. No secrets duplicated.
model WebhookRoute {
  id         String   @id @default(uuid())
  provider   String
  externalId String
  agencyId   String
  businessId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([provider, externalId])
  @@index([agencyId])
}

model BusinessConfig {
  id String @id @default(uuid())

  // White Label Configuration
  whiteLabel               Boolean @default(false)
  subdomain                String? // For agency subdomain (e.g., business.agency.com)
  customDomain             String?
  customRootDomain         String?
  customRootDomainVerified Boolean @default(false)
  companyName              String  @default("")
  onlyLogo                 Boolean @default(false)
  companyLogo              String  @default("")
  primaryColor             String  @default("#000000")
  secondaryColor           String  @default("#ffffff")
  faviconUrl               String  @default("")
  title                    String  @default("")
  description              String? @db.Text

  // Limitations
  maxLeads Int @default(100)

  // Relations 
  businessId String   @unique
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subdomain])
}

model Account {
  id                String  @id @default(uuid())
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Lead {
  id String @id @default(uuid())

  // personal information
  name           String
  firstName      String    @default("")
  lastName       String    @default("")
  email          String?
  bestEmail      String    @default("")
  emailVerified  Boolean   @default(false)
  phone          String?
  bestPhone      String    @default("")
  phoneVerified  Boolean   @default(false)
  dateOfBirth    DateTime?
  leadIsVerified Boolean   @default(false) // if either email or phone is verified
  profileImage   String?

  // general info
  ianaTimezone String  @default("") // Asia/Kolkata
  country      String  @default("") // country of the lead
  city         String  @default("") // city of the lead
  state        String  @default("") // state of the lead
  zipCode      String  @default("") // zip code of the lead
  address      String? @db.Text // address of the lead

  // additional info 
  company         String  @default("") // company name of the lead
  companyShortName String @default("") // company short name of the lead

  companyAddress String? @db.Text
  industry       String  @default("") // ex: Real Estate, Marketing etc.
  website        String  @default("")
  message        String? @db.Text // message sent by the lead
  channel        CHANNEL @default(EMAIL) // lead source channel
  note           String? @db.Text // note about the lead by agency/agent
  fields         Json? // custom fields

  customData Json? // custom data (variables)

  // DND (Do Not Disturb)
  emailDND    Boolean @default(false)
  smsDND      Boolean @default(false)
  callDND     Boolean @default(false)
  whatsappDND Boolean @default(false)

  // Channel Availability - which channels are active/available for this contact
  emailActive     Boolean @default(false)
  smsActive       Boolean @default(false)
  whatsappActive  Boolean @default(false)
  facebookActive  Boolean @default(false)
  instagramActive Boolean @default(false)
  liveChatActive  Boolean @default(false)
  voiceCallActive Boolean @default(false)

  // Channel Specific Metadata Fields
  instagramSID     String?
  instaUsername    String?
  facebookSenderId String?
  facebookUsername String?

  // Metadata 
  status     LEAD_STATUS      @default(NEW)
  statusType LEAD_STATUS_TYPE @default(COLD)
  quality    LEAD_QUALITY     @default(UNQUALIFIED)

  /// Where the lead was first created (e.g. Insta OS automation vs other flows).
  leadSource LEAD_SOURCE @default(UNKNOWN)

  /// First contact sub-source for Insta OS (comment vs DM). Set only on create; see LEAD_SUB_SOURCE.
  leadSubSource LEAD_SUB_SOURCE @default(UNKNOWN)

  /// MiniApp billing period end for the last DM-agent assignment slot this lead consumed (matches MiniAppSubscription.nextLimitResetAt at that time). Null until first counted; new period allows another slot.
  instaOsDmAgentQuotaPeriodEndAt DateTime?

  // other fields
  ghlContactId String?

  /// CRMBridge PMS patient id (opaque foreign key — not a local patient record).
  crmPatientId String?
  /// CRMBridge appointment id after booking writeback.
  crmAppointmentId String?

  /// Stable browser id from website chat embed (localStorage on host page). Unique per business.
  embedVisitorId String?

  // Relations
  agencyId String
  Agency   User   @relation("AgencyToLead", fields: [agencyId], references: [id], onDelete: Cascade)

  businessId String
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  salesAgentId String?
  SalesAgent   User?   @relation("SalesAgentToLead", fields: [salesAgentId], references: [id], onDelete: SetNull)

  /// Sales account this person belongs to (not the tenant Business).
  companyId String?
  Company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  isTestLead     Boolean  @default(false)
  // Metadata Fields
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  Meeting              Meeting[]
  LeadCalls            LeadCall[]
  CampaignLead         CampaignLead[]
  LeadTags             LeadTag[]
  LeadNotes            LeadNote[]
  PrimaryOpportunities Opportunity[]         @relation("OpportunityPrimaryLead")
  OpportunityContacts  OpportunityContact[]
  FollowUp             FollowUp[]
  Conversation         Conversation?
  ConversationMessages ConversationMessage[]
  VoiceSessions        VoiceSession[]
  BaseAgentSessions    BaseAgentSession[]
  AutomationEnrollments AutomationEnrollment[]
  CustomFieldValue     CustomFieldValue[]
  ChatLogs             ChatLog[]
  InstaOsEvents         InstaOsEvent[]
  InstaOsDmOutboxes     InstaOsDmOutbox[]
  LeadJourneyEvents     LeadJourneyEvent[]
  LeadIgAccountConfigs  LeadIgAccountConfig[]
  DentalBridgeBookings  DentalBridgeBooking[]
  DentalBridgePatient   DentalBridgePatient?
  GmbReviews            GmbReview[]
  FunnelFormSubmissions FunnelFormSubmission[]

  @@index([agencyId])
  @@index([salesAgentId])
  @@index([businessId])
  @@index([companyId])
  @@index([status])
  @@index([phone])
  @@index([email])
  @@index([ghlContactId])
  @@index([businessId, leadSource])
  @@index([businessId, leadSubSource])
  @@index([businessId, crmPatientId])
  @@unique([businessId, embedVisitorId])
}

model LeadTag {
  id String @id @default(uuid())

  name  String
  color String

  // Relations
  Leads Lead[]

  businessId String
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, businessId])
  @@index([businessId])
}

model LeadNote {
  id String @id @default(uuid())

  note String         @db.Text
  type LEAD_NOTE_TYPE @default(NOTE)

  // Relations
  leadId String
  Lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
}

/// Append-only lead journey (global; not Insta-OS–only). Written only via createLeadJourneyEvent().
model LeadJourneyEvent {
  id         String            @id @default(uuid())
  text       String            @db.Text
  actor      LEAD_JOURNEY_ACTOR
  metadata   Json?

  leadId     String
  Lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  businessId String
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@index([leadId, createdAt])
  @@index([businessId, leadId])
}

enum LEAD_JOURNEY_ACTOR {
  SYSTEM
  USER
  AUTOMATION
}

model Conversation {
  id String @id @default(uuid())

  starred Boolean @default(false)
  killed  Boolean @default(false)

  replyMode REPLY_MODE @default(AUTO)

  // Follow-up configuration
  followUpActive      Boolean @default(false)
  activeFollowUpIndex Int     @default(0)

  // Relations
  leadId String @unique
  Lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  businessId String
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  agencyId String
  Agency   User   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  activeAgentId String?
  ActiveAgent   PrimaryAgent? @relation(fields: [activeAgentId], references: [id], onDelete: SetNull)

  /// Insta OS Base Agent handling DM chat for this thread (separate from Recall PrimaryAgent).
  activeBaseAgentId String?
  ActiveBaseAgent   BaseAgent? @relation("ConversationActiveBaseAgent", fields: [activeBaseAgentId], references: [id], onDelete: SetNull)

  /// Instagram account this DM thread belongs to (token + sender IGSID for Graph).
  instagramAccountId String?
  InstagramAccount   InstagramAccount? @relation(fields: [instagramAccountId], references: [id], onDelete: SetNull)

  /// WhatsApp account this thread belongs to (Cloud API phone_number_id).
  whatsAppAccountId String?
  WhatsAppAccount   WhatsAppAccount? @relation(fields: [whatsAppAccountId], references: [id], onDelete: SetNull)

  /// WhatsApp free-form messaging service window. Reset by the lead's inbound
  /// WhatsApp message, intentionally buffered before Meta's 24h cutoff.
  whatsAppServiceWindowExpiresAt DateTime?

  /// Instagram standard-messaging service window. Reset by the lead's inbound
  /// IG DM, intentionally buffered before Meta's 24h cutoff.
  instagramServiceWindowExpiresAt DateTime?

  // Metadata
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastMessageAt DateTime @default(now())

  // Relationships
  ConversationMessages ConversationMessage[]
  BaseAgentSessions    BaseAgentSession[]

  @@index([leadId])
  @@index([agencyId])
  @@index([businessId])
  @@index([activeAgentId])
  @@index([activeBaseAgentId])
  @@index([instagramAccountId])
  @@index([id, createdAt])
  @@index([whatsAppAccountId])
}

model ConversationMessage {
  id String @id @default(uuid())

  content String                      @db.Text
  sender  MESSAGE_SENDER              @default(AI_AGENT)
  status  CONVERSATION_MESSAGE_STATUS @default(SENT)
  snippet String                      @default("")

  channel  CHANNEL           @default(EMAIL)
  itemType MESSAGE_ITEM_TYPE @default(MESSAGE)
  source   MESSAGE_SOURCE    @default(RECALLSYNC)

  // SYSTEM EVENTS (tool_calls etc)
  systemEvent       SYSTEM_EVENT?
  systemEventStatus SYSTEM_EVENT_STATUS?
  systemData        Json?
  systemDescription String?              @db.Text // ex: Appointment booked for 10:00 AM on 10th July 2025

  ghlMessageId String?
  /// Platform message id for native channels (Instagram `mid`, WhatsApp `wamid`).
  /// Stored for both inbound and outbound messages so quoted replies can be
  /// resolved back to the local message row.
  externalMessageId String? @db.VarChar(191)
  /// Raw platform message id this inbound message replied to, when supplied by
  /// Instagram / WhatsApp.
  replyToExternalId String? @db.VarChar(191)
  /// Snapshot of the quoted message content. This keeps model history cheap and
  /// preserves context even if the referenced message is later edited/deleted.
  replyToContent String? @db.Text
  replyToSender  MESSAGE_SENDER?

  /// Set for LEAD inbound from GHL recall-high webhook; @@unique skips duplicate webhook/worker retries.
  sourceInboundDedupKey String? @db.VarChar(512)

  rsRunId String?

  // Call Message Items
  callId String?
  Call   LeadCall? @relation(fields: [callId], references: [id], onDelete: Cascade)

  // Relations
  leadId String
  Lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  agencyId String
  Agency   User   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  businessId String
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  conversationId String
  Conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// IG account that sent/received this message (channel INSTAGRAM only).
  instagramAccountId String?
  InstagramAccount   InstagramAccount? @relation(fields: [instagramAccountId], references: [id], onDelete: SetNull)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// AES-encrypted chat body fields when Dental Bridge HIPAA mode is enabled.
  isPhiEncrypted Boolean @default(false)
  /// When set, cron purges this row after the retention window (creation + 14 days).
  phiDeleteAt    DateTime?

  @@index([leadId])
  @@index([conversationId])
  @@index([conversationId, instagramAccountId, createdAt])
  @@index([instagramAccountId])
  @@index([externalMessageId])
  @@index([conversationId, businessId, externalMessageId])
  @@index([callId])
  @@index([agencyId])
  @@index([businessId])
  @@index([rsRunId])
  @@index([phiDeleteAt])
  @@unique([sourceInboundDedupKey])
}

/// One row per claimed GHL InboundMessage delivery (dedup across webhook/QStash/worker retries).
model GhlInboundWebhookDelivery {
  dedupKey            String    @id @db.VarChar(512)
  claimedAt           DateTime  @default(now())
  enqueuedAt          DateTime?
  processingStartedAt DateTime?
  completedAt         DateTime?
  lastError           String?   @db.Text
  payloadJson         String    @db.Text

  @@index([completedAt])
  @@index([claimedAt])
}

enum PRIMARY_AGENT_TYPE {
  // Agency-level primary, selectable in the Recall agent picker.
  RECALL
  // Per-business auto-managed primary owned by the IgThreadly mini-app.
  // One per business; created on demand when the first STANDARD/FLOW
  // BaseAgent is created inside IgThreadly. Not selectable in the Recall picker.
  IGTHREADLY
}

model PrimaryAgent {
  id String @id @default(uuid())

  type PRIMARY_AGENT_TYPE @default(RECALL)

  name         String
  internalName String  @default("")
  description  String? @db.Text

  agentGoal               String? @db.Text
  goalCompleteCriteria    String? @db.Text
  stopScenarioDescription String? @db.Text

  // agent training 
  // {url}/train -> agent traning url 
  // {url}/create -> create vector indexes 
  // {url}/update -> update vector indexes
  // {url}/delete -> delete vector indexes
  n8nTrainingUrl   String @default("")
  n8nTrainingToken String @default("")

  // e.g. { "enabled": true, "triggers": [{ "type": "RESTART_SESSION", "value": "/restart" }] }
  actionTriggers Json?

  // Relations
  businessId String
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  agencyId String
  Agency   User   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  ghlCalendarId         String?
  calenderIntegrationId String?
  calendarType          CALENDAR_TYPE        @default(CAL)
  CalenderIntegration   CalenderIntegration? @relation(fields: [calenderIntegrationId], references: [id], onDelete: SetNull)

  // nextPrimaryAgent
  nextPrimaryAgentId String?
  NextPrimaryAgent   PrimaryAgent?  @relation("NextPrimaryAgents", fields: [nextPrimaryAgentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  NextPrimaryAgents  PrimaryAgent[] @relation("NextPrimaryAgents")

  Conversations      Conversation[]
  PrimaryAgentAssets PrimaryAgentAsset[]
  VoiceSessions      VoiceSession[]
  Campaigns          Campaign[]
  Automations        Automation[]
  Knowledgebases     Knowledgebase[]
  BaseAgents  BaseAgent[] @relation("PrimaryAgentBaseAgents")

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([businessId, type])
  @@index([agencyId])
  @@index([calenderIntegrationId])
  @@index([nextPrimaryAgentId])
}

model PrimaryAgentAsset {
  id String @id @default(uuid())

  name        String  @default("")
  description String? @db.Text

  // UPLOADTHING
  fileUrl  String
  fileKey  String
  fileType String
  fileSize Int    @default(0) // in KB

  // Relations
  primaryAgentId String
  PrimaryAgent   PrimaryAgent @relation(fields: [primaryAgentId], references: [id], onDelete: Cascade)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([primaryAgentId])
}

model AgentTool {
  id String @id @default(uuid())

  definition Json

  BaseAgents  BaseAgent[]

  businessId String
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
}

model Meeting {
  id        String @id @default(uuid())
  meetingId String

  startTime     String
  messageOfLead String         @db.Text
  meetingUrl    String?
  status        MEETING_STATUS @default(UPCOMING)

  rescheduleReason   String? @db.Text
  cancellationReason String? @db.Text

  // Relations
  salesAgentId String?
  SalesAgent   User?   @relation("SalesAgentToMeeting", fields: [salesAgentId], references: [id], onDelete: SetNull)

  businessId String
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  agencyId String
  Agency   User   @relation("AgencyToMeeting", fields: [agencyId], references: [id], onDelete: Cascade)

  leadId String
  Lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  calendarType  CALENDAR_TYPE  @default(CAL)
  meetingSource MEETING_SOURCE @default(PLATFORM)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, meetingId])
  @@index([agencyId])
  @@index([salesAgentId])
  @@index([businessId])
  @@index([leadId])
}

model LeadCall {
  id         String  @id @default(uuid())
  callId     String  @default("")
  notes      String? @db.Text
  summary    String? @db.Text

  structuredOutput Json? @default("{}")

  transcript Json?
  audioUrl   String  @default("")

  type          CALL_TYPE            @default(OUTBOUND)
  endedReason   CALL_END_REASON      @default(unknown_error)
  callStat      CALL_STAT            @default(NOT_PICKED)
  userReplyStat CALL_USER_REPLY_STAT @default(NO_ANSWER)
  result        CALL_RESULT          @default(SUCCESS)
  callType      LEAD_CALL_TYPE       @default(GLOBAL)
  callSource    CALL_SOURCE          @default(VAPI)

  callDuration  Float @default(0)
  costVoice     Float @default(0) // total voiceAi cost
  costTelephony Float @default(0) // total telephony cost
  totalCost     Float @default(0) // total call cost

  // Relations
  leadId String?
  Lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  agencyId String
  Agency   User   @relation("AgencyToLeadCall", fields: [agencyId], references: [id], onDelete: Cascade)

  businessId String
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  salesAgentId String?
  SalesAgent   User?   @relation("SalesAgentToLeadCall", fields: [salesAgentId], references: [id], onDelete: SetNull)

  campaignId String?
  Campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  poolNumberId    String?
  PoolPhoneNumber PoolPhoneNumber? @relation(fields: [poolNumberId], references: [id], onDelete: SetNull)

  // Metadata
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  ConversationMessages ConversationMessage[]
  VoiceSessions      VoiceSession[]

  @@index([agencyId])
  @@index([salesAgentId])
  @@index([leadId])
  @@index([campaignId])
  @@index([businessId])
  @@index([poolNumberId])
}

model Campaign {
  id String @id @default(uuid())

  name        String
  description String          @db.Text
  status      CAMPAIGN_STATUS @default(DRAFT)

  // Settings
  withRetries       Boolean   @default(false)
  withFollowUp      Boolean   @default(false)
  retries           Int       @default(3)
  maxRetryAttempts  Int       @default(3)
  callBackDelay     Int       @default(60)
  concurrentCalls   Int       @default(1)
  startDate         DateTime?
  startTime         String    @default("05:30")
  workingHoursStart String    @default("09:00")
  workingHoursEnd   String    @default("17:00")
  timeZone          String    @default("IST")
  settingsUpdated   Boolean   @default(false)

  // New Settings Fields
  retryInterval     Int?    @default(2)
  retryIntervalType String? @default("hour") // "hour" | "day"
  weeklySchedule    Json? // Weekly schedule with time slots per day

  // Channels the campaign's primary agent should contact on (passed to triggerAgent).
  // JSON array of CHANNEL strings + NONE for no channels. Empty = all of the agent's channels.
  channels Json?

  /** Max new outbound lead pickups per local day (voice + SMS + WhatsApp). null = unlimited. */
  dailyOutboundLimit Int?
  /** Running count for today; reset at midnight in campaign.timeZone. */
  outboundToday      Int @default(0)

  // Relations
  agencyId String
  Agency   User   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  businessId String
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  assistants Assistant[]

  primaryAgentId String?
  PrimaryAgent   PrimaryAgent? @relation(fields: [primaryAgentId], references: [id], onDelete: Cascade)

  /// Optional post-outreach journey — enrolled when campaign picks up a lead.
  automationId String?
  Automation   Automation? @relation(fields: [automationId], references: [id], onDelete: SetNull)

  // Optional outbound caller-ID pool for voice rotation.
  numberPoolId String?
  NumberPool   NumberPool? @relation(fields: [numberPoolId], references: [id], onDelete: SetNull)

  type              CAMPAIGN_TYPE @default(VOICE_REACTIVATION)
  gmbReviewSettings Json?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  CampaignLeads CampaignLead[]
  LeadCalls     LeadCall[]
  GmbReviews    GmbReview[]

  @@index([agencyId])
  @@index([businessId])
  @@index([primaryAgentId])
  @@index([automationId])
  @@index([numberPoolId])
  @@index([businessId, type, status])
}

model NumberPool {
  id   String @id @default(uuid())
  name String

  defaultDailyCap        Int @default(50)
  defaultConcurrentLimit Int @default(2)
  defaultMinGapSeconds   Int @default(8)

  agencyId String
  Agency   User   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  businessId String
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  numbers   PoolPhoneNumber[]
  campaigns Campaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId])
  @@index([businessId])
}

model PoolPhoneNumber {
  id String @id @default(uuid())

  e164              String
  provider          VOICE_POOL_PROVIDER
  providerId        String
  Provider          Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerNumberRef String

  status            POOL_NUMBER_STATUS @default(WARMING)
  dailyCap          Int
  concurrentLimit   Int
  minGapSeconds     Int

  callsToday      Int       @default(0)
  concurrentCalls Int       @default(0)
  lastCallAt      DateTime?

  acceptanceRate Float?
  pausedReason   String? @db.Text

  poolId     String
  NumberPool NumberPool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  agencyId String
  Agency   User   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  businessId String
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  leadCalls LeadCall[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([poolId, e164])
  @@index([poolId])
  @@index([providerId])
  @@index([agencyId])
  @@index([businessId])
  @@index([status])
}

model CampaignLead {
  id String @id @default(uuid())

  campaignId String
  Campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  leadId String
  Lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  agencyId String
  Agency   User   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  businessId String
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  status     CAMPAIGN_LEAD_STATUS  @default(PENDING)
  quality    CAMPAIGN_LEAD_QUALITY @default(LOW)
  result     CAMPAIGN_LEAD_RESULT  @default(SUCCESS)
  notes      String?               @db.Text
  followUpAt DateTime?

  calledAt    DateTime?
  retriesLeft Int       @default(3)
  nextRetryAt DateTime?

  GmbReviews GmbReview[]

  @@index([agencyId])
  @@index([businessId])
  @@index([campaignId])
  @@index([leadId])
}

enum PIPELINE_STAGE_COLOR_MODE {
  NONE
  DOT
  BACKGROUND
}

model Pipeline {
  id   String @id @default(uuid())
  name String
  stageColorMode PIPELINE_STAGE_COLOR_MODE @default(DOT)

  // Relations
  agencyId String
  Agency   User   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  businessId String
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stages        Stage[]
  Opportunities Opportunity[]

  @@index([agencyId])
  @@index([businessId])
}

model Stage {
  id    String @id @default(uuid())
  name  String
  order Int    @default(0)
  color String @default("")

  Pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  pipelineId String

  agencyId String
  Agency   User   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  businessId String
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  Opportunities Opportunity[]

  @@index([pipelineId])
  @@index([agencyId])
  @@index([businessId])
}

/// Sales account (GHL Company). Not the tenant `Business`.
model Company {
  id String @id @default(uuid())
  name String

  email    String  @default("")
  phone    String  @default("")
  website  String  @default("")
  industry String  @default("")

  address String? @db.Text
  city    String  @default("")
  state   String  @default("")
  zipCode String  @default("")
  country String  @default("")

  salesAgentId String?
  SalesAgent   User?   @relation("SalesAgentToCompany", fields: [salesAgentId], references: [id], onDelete: SetNull)

  agencyId String
  Agency   User   @relation("AgencyToCompany", fields: [agencyId], references: [id], onDelete: Cascade)

  businessId String
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  Leads         Lead[]
  Opportunities Opportunity[]
  CustomFieldValues CompanyCustomFieldValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId])
  @@index([businessId])
  @@index([salesAgentId])
  @@index([name])
}

model Opportunity {
  id          String             @id @default(uuid())
  name        String
  description String?            @db.Text
  status      OPPORTUNITY_STATUS @default(OPEN)
  lostReason  String             @default("")
  source      String             @default("")
  value       Float?

  order Int @default(0)

  stageId String
  Stage   Stage  @relation(fields: [stageId], references: [id], onDelete: Cascade)

  pipelineId String
  Pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  /// Required. The company owns the deal.
  companyId String
  Company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Optional main point of contact. People come and go; the deal stays.
  primaryLeadId String?
  PrimaryLead   Lead?   @relation("OpportunityPrimaryLead", fields: [primaryLeadId], references: [id], onDelete: SetNull)

  salesAgentId String?
  SalesAgent   User?   @relation("SalesAgentToOpportunity", fields: [salesAgentId], references: [id], onDelete: SetNull)

  agencyId String
  Agency   User   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  businessId String
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  Contacts OpportunityContact[]
  DiscoveryRecord DiscoveryRecord?
  CustomFieldValues OpportunityCustomFieldValue[]
  Quotes Quote[]
  Contracts Contract[]

  addedToStageAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stageId])
  @@index([pipelineId])
  @@index([companyId])
  @@index([primaryLeadId])
  @@index([salesAgentId])
  @@index([agencyId])
  @@index([businessId])
}

/// Extra touchpoints on a deal. Primary lead is not stored here.
model OpportunityContact {
  id String @id @default(uuid())

  role String @default("")

  opportunityId String
  Opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  leadId String
  Lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([opportunityId, leadId])
  @@index([opportunityId])
  @@index([leadId])
}

/// Per-business UI labels for system objects. Schema keys never change.
model BusinessObjectConfig {
  id       String        @id @default(uuid())
  object   SYSTEM_OBJECT
  singular String
  plural   String

  businessId String
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, object])
  @@index([businessId])
}

enum CUSTOM_OBJECT_FIELD_TYPE {
  TEXT
  TEXTAREA
  TEXT_LIST
  NUMBER
  PHONE
  MONETARY
  SINGLE_SELECT
  MULTI_SELECT
  RADIO
  CHECKBOX
  FILE
  DATE
}

enum CUSTOM_OBJECT_RECORD_LIFECYCLE {
  NONE
  OPPORTUNITY_SINGLE_DRAFT
}

model CustomObject {
  id          String  @id @default(uuid())
  singular    String
  plural      String
  slug        String
  description String  @default("")
  icon        String  @default("box")
  showInMenu  Boolean @default(true)
  isSystem    Boolean @default(false)

  recordLifecycle CUSTOM_OBJECT_RECORD_LIFECYCLE @default(NONE)

  lifecycleStatusFieldId String? @unique
  LifecycleStatusField   CustomObjectField? @relation("CustomObjectLifecycleStatusField", fields: [lifecycleStatusFieldId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  lifecycleAssociationDefinitionId String? @unique
  LifecycleAssociationDefinition   AssociationDefinition? @relation("CustomObjectLifecycleAssociation", fields: [lifecycleAssociationDefinitionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  agencyId String
  Agency   User   @relation("AgencyToCustomObject", fields: [agencyId], references: [id], onDelete: Cascade)

  businessId String
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  Fields  CustomObjectField[]
  Records CustomObjectRecord[]
  AssociationDefinitionsA AssociationDefinition[] @relation("AssociationDefinitionA")
  AssociationDefinitionsB AssociationDefinition[] @relation("AssociationDefinitionB")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, slug])
  @@index([agencyId])
  @@index([businessId])
}

model CustomObjectField {
  id         String                    @id @default(uuid())
  key        String
  label      String
  type       CUSTOM_OBJECT_FIELD_TYPE
  options    Json?
  isPrimary  Boolean                   @default(false)
  isUnique   Boolean                   @default(false)
  isSystem   Boolean                   @default(false)
  order      Int                       @default(0)

  customObjectId String
  CustomObject   CustomObject @relation(fields: [customObjectId], references: [id], onDelete: Cascade)

  LifecycleStatusForObject CustomObject? @relation("CustomObjectLifecycleStatusField")

  Values CustomObjectRecordValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customObjectId, key])
  @@index([customObjectId])
}

model CustomObjectRecord {
  id           String @id @default(uuid())
  primaryValue String @default("")

  customObjectId String
  CustomObject   CustomObject @relation(fields: [customObjectId], references: [id], onDelete: Cascade)

  agencyId String
  businessId String
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  Values CustomObjectRecordValue[]
  DiscoveryRecord DiscoveryRecord?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customObjectId])
  @@index([businessId])
  @@index([customObjectId, primaryValue])
}

model CustomObjectRecordValue {
  id    String  @id @default(uuid())
  value String? @db.Text

  recordId String
  Record   CustomObjectRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  fieldId String
  Field   CustomObjectField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([recordId, fieldId])
  @@index([recordId])
  @@index([fieldId])
}

enum ASSOCIATION_OBJECT_KIND {
  CUSTOM
  LEAD
  COMPANY
  OPPORTUNITY
}

enum ASSOCIATION_CARDINALITY {
  ONE
  MANY
}

/// What can link, labels, and cardinality on each side. Links are AssociationLink.
model AssociationDefinition {
  id    String @id @default(uuid())
  label String

  aKind           ASSOCIATION_OBJECT_KIND
  aCustomObjectId String?
  ACustomObject   CustomObject?           @relation("AssociationDefinitionA", fields: [aCustomObjectId], references: [id], onDelete: Cascade)
  aLabel          String                  @default("")
  aMax            ASSOCIATION_CARDINALITY

  bKind           ASSOCIATION_OBJECT_KIND
  bCustomObjectId String?
  BCustomObject   CustomObject?           @relation("AssociationDefinitionB", fields: [bCustomObjectId], references: [id], onDelete: Cascade)
  bLabel          String                  @default("")
  bMax            ASSOCIATION_CARDINALITY

  isSystem Boolean @default(false)

  agencyId String
  Agency   User   @relation("AgencyToAssociationDefinition", fields: [agencyId], references: [id], onDelete: Cascade)

  businessId String
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  Links AssociationLink[]

  LifecycleAssociationForObject CustomObject? @relation("CustomObjectLifecycleAssociation")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([agencyId])
  @@index([aCustomObjectId])
  @@index([bCustomObjectId])
}

/// One linked pair for a definition. Record ids are polymorphic (kind lives on the definition).
model AssociationLink {
  id String @id @default(uuid())

  definitionId String
  Definition   AssociationDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  aRecordId String
  bRecordId String

  createdAt DateTime @default(now())

  @@unique([definitionId, aRecordId, bRecordId])
  @@index([definitionId, aRecordId])
  @@index([definitionId, bRecordId])
}

enum DISCOVERY_FIELD_OBJECT {
  DISCOVERY
  COMPANY
  OPPORTUNITY
  LEAD
}

enum OBJECT_CUSTOM_FIELD_OWNER {
  COMPANY
  OPPORTUNITY
  PRODUCT
}

enum PRODUCT_PRICE_TYPE {
  ONE_TIME
  RECURRING
}

model Product {
  id          String @id @default(uuid())
  title       String
  description String @db.Text
  imageUrl    String @default("")
  sku         String @default("")

  priceType      PRODUCT_PRICE_TYPE @default(ONE_TIME)
  amount         Decimal            @db.Decimal(12, 2)
  currency       String             @default("AUD")
  compareAtPrice Decimal?           @db.Decimal(12, 2)

  active Boolean @default(true)

  agencyId   String
  businessId String
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  CustomFieldValues ProductCustomFieldValue[]
  QuoteLineItems QuoteLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([agencyId])
  @@index([businessId, title])
}

model ProductCustomFieldValue {
  id    String  @id @default(uuid())
  value String? @db.Text

  productId String
  Product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  fieldId String
  Field   ObjectCustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, fieldId])
  @@index([productId])
  @@index([fieldId])
}

enum DOCUMENT_TEMPLATE_KIND {
  QUOTE
  CONTRACT
}

enum DOCUMENT_TEMPLATE_STATUS {
  DRAFT
  PUBLISHED
}

enum QUOTE_STATUS {
  DRAFT
  SENT
  CHANGES_REQUESTED
  APPROVED
  DECLINED
  EXPIRED
  SUPERSEDED
}

enum CONTRACT_STATUS {
  DRAFT
  SENT
  SIGNED
  DECLINED
  EXPIRED
}

/// Shared document template for quotes, contracts, and future kinds.
model DocumentTemplate {
  id          String                   @id @default(uuid())
  name        String
  description String                   @default("")
  kind        DOCUMENT_TEMPLATE_KIND
  status      DOCUMENT_TEMPLATE_STATUS @default(DRAFT)
  /// Block layout JSON ({ schemaVersion, pages: [...] })
  layout      Json?

  agencyId   String
  businessId String
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  Quotes Quote[]
  Contracts Contract[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([agencyId])
  @@index([businessId, kind])
}

model Quote {
  id          String       @id @default(uuid())
  quoteNumber String
  version     Int          @default(1)
  status      QUOTE_STATUS @default(DRAFT)

  opportunityId String
  Opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  /// Groups all versions of one deal quote (first version sets to its own id).
  rootQuoteId String

  supersededById String?

  documentTemplateId String?
  DocumentTemplate   DocumentTemplate? @relation(fields: [documentTemplateId], references: [id], onDelete: SetNull)

  currency            String  @default("AUD")
  contractTermMonths  Int?
  discountAmount      Decimal @default(0) @db.Decimal(12, 2)
  discountPercent     Decimal @default(0) @db.Decimal(5, 2)
  validUntil          DateTime?
  notes               String?  @db.Text

  financeSelected     Boolean @default(false)
  financeTermMonths   Int?
  financeAmountEx     Decimal? @db.Decimal(12, 2)
  upfrontAmountEx     Decimal? @db.Decimal(12, 2)

  mrrEx           Decimal @default(0) @db.Decimal(12, 2)
  oneOffEx        Decimal @default(0) @db.Decimal(12, 2)
  internalCostEx  Decimal @default(0) @db.Decimal(12, 2)
  grossProfitEx   Decimal @default(0) @db.Decimal(12, 2)
  marginPct       Decimal @default(0) @db.Decimal(5, 2)

  /// Frozen render at send time (future milestone).
  documentSnapshot Json?
  mergedContextSnapshot Json?

  createdByUserId String?
  CreatedBy       User?   @relation("QuoteCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  agencyId   String
  businessId String
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  LineItems QuoteLineItem[]
  Contracts Contract[]

  sentAt     DateTime?
  approvedAt DateTime?

  /// First view + approval IP/location for the PDF certificate page.
  sendLinkAudit Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, quoteNumber, version])
  @@index([businessId])
  @@index([opportunityId])
  @@index([rootQuoteId])
  @@index([status])
  @@index([documentTemplateId])
}

model QuoteLineItem {
  id String @id @default(uuid())

  quoteId String
  Quote   Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  productId String?
  Product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  title         String
  description   String?          @db.Text
  sku           String           @default("")
  priceType     PRODUCT_PRICE_TYPE
  unitAmount    Decimal          @db.Decimal(12, 2)
  internalCost  Decimal          @default(0) @db.Decimal(12, 2)
  quantity      Int              @default(1)
  sortOrder     Int              @default(0)

  siteRecordId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quoteId])
  @@index([productId])
}

model Contract {
  id             String          @id @default(uuid())
  contractNumber String
  version        Int             @default(1)
  status         CONTRACT_STATUS @default(DRAFT)

  opportunityId String
  Opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  rootContractId String

  /// Optional approved quote used for merge fields (line items, totals).
  quoteId String?
  Quote   Quote?  @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  documentTemplateId String?
  DocumentTemplate   DocumentTemplate? @relation(fields: [documentTemplateId], references: [id], onDelete: SetNull)

  currency String  @default("AUD")
  notes    String? @db.Text

  documentSnapshot      Json?
  mergedContextSnapshot Json?
  /// Fillable field responses keyed by block id.
  fieldResponses        Json?

  createdByUserId String?
  CreatedBy       User?   @relation("ContractCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  agencyId   String
  businessId String
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  sentAt   DateTime?
  signedAt DateTime?

  /// First view + signature IP/location for the PDF certificate page.
  sendLinkAudit Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, contractNumber, version])
  @@index([businessId])
  @@index([opportunityId])
  @@index([rootContractId])
  @@index([status])
  @@index([documentTemplateId])
  @@index([quoteId])
}

/// Layout for a Discovery worksheet. Many per business (Website Development, Hosting, …).
model DiscoveryTemplate {
  id          String @id @default(uuid())
  name        String
  description String @default("")

  /// The canvas. Source of truth. One document, replaced on save.
  layout Json?

  agencyId   String
  businessId String
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  /// Legacy row tables. Read fallback only until layouts are saved as JSON.
  Rows    DiscoveryRow[]
  Records DiscoveryRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([agencyId])
}

model DiscoveryRow {
  id    String @id @default(uuid())
  order Int    @default(0)

  templateId String
  Template   DiscoveryTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  Columns DiscoveryColumn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateId])
}

model DiscoveryColumn {
  id    String @id @default(uuid())
  order Int    @default(0)

  rowId String
  Row   DiscoveryRow @relation(fields: [rowId], references: [id], onDelete: Cascade)

  Placements DiscoveryFieldPlacement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rowId])
}

/// A cell on the template. Points at an existing field; never creates one.
model DiscoveryFieldPlacement {
  id            String                 @id @default(uuid())
  object        DISCOVERY_FIELD_OBJECT
  nativeKey     String                 @default("")
  customFieldId String                 @default("")
  /// Extra write targets: [{ object, nativeKey?, customFieldId? }]
  alsoWriteTo   Json?
  order         Int                    @default(0)

  columnId String
  Column   DiscoveryColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([columnId])
}

/// 1–1 Opportunity ↔ Discovery record. Template is locked after create.
model DiscoveryRecord {
  id String @id @default(uuid())

  recordId String             @unique
  Record   CustomObjectRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

