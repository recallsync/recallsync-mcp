// Agentic Layer Tables
model VoiceSession {
  id String @id @default(uuid())

  rsRunId   String? // optional legacy observability
  rsAgentId String?

  /// Browser/widget test sessions (no PSTN). Used for LiveKit join + token minting.
  isWebTest        Boolean @default(false)
  livekitRoomName  String?

  /// WhatsApp Business Calling API session id (wacid.*).
  whatsappCallId     String? @unique
  whatsAppAccountId  String?
  voiceChannel       CHANNEL?

  status       VOICE_SESSION_STATUS @default(CALLING)
  statusReason String?              @db.Text
  errorMessage String?              @db.Text

  // Relations
  agencyId String
  Agency   User   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  businessId String
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  leadId String
  Lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  primaryAgentId String
  PrimaryAgent   PrimaryAgent @relation(fields: [primaryAgentId], references: [id], onDelete: Cascade)

  baseAgentId String?
  BaseAgent   BaseAgent? @relation(fields: [baseAgentId], references: [id], onDelete: Cascade)

  leadCallId String? 
  LeadCall   LeadCall? @relation(fields: [leadCallId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([leadId])
  @@index([agencyId])
  @@index([primaryAgentId])
  @@index([baseAgentId])
  @@index([status])
  @@index([leadCallId])
}

model ChatLog {
  id String @id @default(uuid())

  type    CHAT_LOG_TYPE @default(SUCCESS)
  logType LOG_TYPE      @default(EVENT)

  title       String
  description String? @db.Text // description of the log
  data        Json? // data of the log

  chatAgentId   String?
  chatAgentName String  @default("")

  leadId String
  Lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  endReason     String  @default("")
  chatSessionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([chatAgentId])
  @@index([createdAt])
  @@index([leadId, createdAt])
}

/// Recall workflow definition (in-project executor — no Restack).
model Automation {
  id String @id @default(uuid())

  name        String
  description String?          @db.Text
  status      AutomationStatus @default(DRAFT)

  /// Published graph: `{ version: 1, entryNodeId, nodes[], edges[] }`
  flow Json?

  businessId String
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  agencyId String
  Agency   User   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  primaryAgentId String
  PrimaryAgent   PrimaryAgent @relation(fields: [primaryAgentId], references: [id], onDelete: Cascade)

  /// Per-automation secret for webhook trigger URLs (Bearer or ?token=).
  webhookSecret String? @unique

  Enrollments AutomationEnrollment[]
  Campaigns   Campaign[]
  WebhookTestEvents AutomationWebhookTestEvent[]
  WebhookInvocations AutomationWebhookInvocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([agencyId])
  @@index([primaryAgentId])
  @@index([businessId, status])
}

/// Per-lead workflow run — DB-backed step pointer + optional wait schedule.
model AutomationEnrollment {
  id String @id @default(uuid())

  automationId String
  Automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  leadId String
  Lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  businessId String
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  agencyId String
  Agency   User   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  status AutomationEnrollmentStatus @default(ACTIVE)

  /// Flow node id (`nodes[].id`) — null until first step resolves.
  currentStepId String?

  /// When set with status WAITING, cron/QStash resumes at or after this time.
  nextRunAt DateTime?

  /// Bump on each transition; workers must pass matching version (idempotency).
  runVersion Int @default(0)

  context Json @default("{}")

  cancelReason String? @db.Text
  lastError    String? @db.Text

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  WebhookInvocation AutomationWebhookInvocation?

  @@unique([automationId, leadId])
  @@index([leadId])
  @@index([automationId])
  @@index([businessId, status, nextRunAt])
}

/// Captured test webhook payloads (builder debug — never runs prod enrollment).
model AutomationWebhookTestEvent {
  id           String   @id @default(uuid())
  automationId String
  Automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  payload      Json
  headers      Json?
  query        Json?
  receivedAt   DateTime @default(now())

  @@index([automationId, receivedAt])
}

enum AutomationWebhookInvocationStatus {
  PENDING
  COMPLETED
  TIMED_OUT
}

/// Sync webhook HTTP response state (RESPOND_TO_WEBHOOK mode).
model AutomationWebhookInvocation {
  id             String                          @id @default(uuid())
  automationId   String
  Automation     Automation                      @relation(fields: [automationId], references: [id], onDelete: Cascade)
  enrollmentId   String                          @unique
  Enrollment     AutomationEnrollment            @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  status         AutomationWebhookInvocationStatus @default(PENDING)
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime                        @default(now())
  completedAt    DateTime?

  @@index([automationId, createdAt])
}

