  SipTrunks            SipTrunk[]
  Knowledgebases       Knowledgebase[]
  InstagramAccounts    InstagramAccount[]
  WhatsAppAccounts     WhatsAppAccount[]
  WhatsAppMessageTemplates WhatsAppMessageTemplate[]
  InstaOsAutomation    InstaOsAutomation[]
