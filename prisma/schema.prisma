/// Dental Bridge (DentWire) per-business settings — CRMBridge defaults, booking mode, HIPAA.
model DentalBridgeSettings {
  id         String   @id @default(uuid())
  businessId String   @unique
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  hipaaMode   Boolean                  @default(false)

  /// CRMBridge clinic identifiers (credentials live on Provider CRM_BRIDGE).
  crmPracticeId              String @default("")
  defaultProviderId          String @default("")
  defaultOperatoryId         String @default("")
  defaultAppointmentReason   String @default("New Patient Exam")
  defaultAppointmentLengthMinutes Int @default(60)
  slotSearchDaysAhead        Int    @default(14)

  /// Stripe deposit path (DFY manual key entry per business). Nullable — MySQL TEXT cannot use @default("").
  stripeSecretKey      String? @db.Text
  stripeWebhookSecret  String? @db.Text
  stripeDepositAmountCents Int?

  /// IANA timezone for appointments, reminders, and widget display (e.g. America/New_York).
  /// Must be set explicitly — empty until configured in Settings.
  timezone       String @default("")
  /// Public booking widget copy + styling defaults (landing page block may override header fields).
  widgetSettings Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
}

/// Reminder automation master switch + rules for widget/agent bookings.
model DentalBridgeReminderConfig {
  id         String   @id @default(uuid())
  businessId String   @unique
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  enabled Boolean @default(false)
  rules   DentalBridgeReminderRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DentalBridgeReminderRule {
  id       String @id @default(uuid())
  configId String
  Config   DentalBridgeReminderConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  category DENTAL_BRIDGE_REMINDER_CATEGORY
  trigger  DENTAL_BRIDGE_REMINDER_TRIGGER
  channel  DENTAL_BRIDGE_REMINDER_CHANNEL @default(EMAIL)
  amount   Int
  unit     DENTAL_BRIDGE_REMINDER_OFFSET_UNIT
  subject  String
  bodyHtml String @db.Text
  sortOrder Int   @default(0)
  enabled  Boolean @default(true)

  logs DentalBridgeReminderLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([configId, sortOrder])
}

/// Semantic dedup — one successful send per booking × trigger × channel × timing.
/// Not tied to rule row id; survives rule edits/deletes.
model DentalBridgeReminderDedup {
  id         String @id @default(uuid())
  businessId String
  bookingId  String
  Booking    DentalBridgeBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  trigger DENTAL_BRIDGE_REMINDER_TRIGGER
  channel DENTAL_BRIDGE_REMINDER_CHANNEL
  amount  Int
  unit    DENTAL_BRIDGE_REMINDER_OFFSET_UNIT

  logId String @unique
  Log   DentalBridgeReminderLog @relation(fields: [logId], references: [id], onDelete: Cascade)

  sentAt DateTime @default(now())

  @@unique([bookingId, trigger, channel, amount, unit])
  @@index([businessId, sentAt])
  @@index([bookingId])
}

model DentalBridgeReminderLog {
  id         String @id @default(uuid())
  businessId String
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  bookingId String?
  leadId    String?
  /// Optional — debug only; audit uses snapshot fields below.
  ruleId    String?
  Rule      DentalBridgeReminderRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  trigger    DENTAL_BRIDGE_REMINDER_TRIGGER?
  category   DENTAL_BRIDGE_REMINDER_CATEGORY?
  channel    DENTAL_BRIDGE_REMINDER_CHANNEL?
  ruleAmount Int?
  ruleUnit   DENTAL_BRIDGE_REMINDER_OFFSET_UNIT?
  status     DENTAL_BRIDGE_REMINDER_LOG_STATUS
  isTest     Boolean @default(false)

  recipientEmail String
  subject        String?
  bodySnapshot   String? @db.Text
  errorMessage   String? @db.Text
  messageId      String?
  sentAt         DateTime @default(now())

  Dedup DentalBridgeReminderDedup?

  @@index([businessId, sentAt])
  @@index([bookingId])
  @@index([leadId])
  @@index([bookingId, trigger, channel, status])
}

/// Widget/admin treatment catalog — maps to CRMBridge specialty + booking defaults.
model DentalBridgeTreatment {
  id                       String   @id @default(uuid())
  businessId               String
  Business                 Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name                     String
  slug                     String
  description              String?  @db.Text
  appointmentReason        String
  appointmentLengthMinutes Int      @default(30)
  /// Matches CRMBridge GetProviders.Specialty (e.g. "Dentist", "Hygienist").
  providerSpecialty        String
  requiresDeposit          Boolean  @default(true)
  /// When requiresDeposit; null falls back to DentalBridgeSettings.stripeDepositAmountCents.
  depositAmountCents       Int?
  sortOrder                Int      @default(0)
  active                   Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, slug])
  @@index([businessId, active])
  @@index([businessId, sortOrder])
}

/// Website booking widget session — funnel state + slot operatory candidates.
model DentalBridgeBookingSession {
  id                 String   @id @default(uuid())
  businessId         String
  Business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  websiteId          String?
  leadId             String?
  treatmentId        String
  step               DENTAL_BRIDGE_WIDGET_SESSION_STEP @default(STARTED)
  providerPreference DENTAL_BRIDGE_PROVIDER_PREFERENCE @default(NAMED)
  providerId         String?
  providerDisplayName String?
  providerSpecialty  String?
  selectedDate       String?
  selectedTimeHour   Int?
  selectedTimeMin    Int?
  slotCandidates     Json?
  selectedSlotKey    String?
  resolvedProviderId String?
  resolvedOperatoryId String?
  bookingId          String?
  expiresAt          DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([businessId, expiresAt])
  @@index([businessId, step])
}

/// Shared Local Presence settings (GMB review URL, SEO defaults).
model LocalPresenceSettings {
  id         String   @id @default(uuid())
  businessId String   @unique
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  googleReviewUrl      String? @db.Text
  targetDomain         String?
  defaultLocationCode  Int?
  defaultLocationName  String?
  seoTimezone          String  @default("UTC")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
}

/// Multi-page website container — bound to a custom domain when connected.
model Website {
  id         String   @id @default(uuid())
  businessId String
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name   String
  slug   String
  /// Public hostname e.g. www.acmedental.com — globally unique when set.
  hostname           String? @unique
  hostnameVerified   Boolean @default(false)
  settings           Json?

  folders WebsiteFolder[]
  pages   LandingPage[]
  globalComponents WebsiteGlobalComponent[]

  supabaseConnection WebsiteSupabaseConnection?
  secrets            WebsiteSecret[]
  actions            WebsiteAction[]
  customPages        WebsiteCustomPage[]

  /// Assigned site-wide header/footer global component ids (no FK — avoids relation cycles).
  headerGlobalComponentId String?
  footerGlobalComponentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, slug])
  @@index([businessId])
}

/// BYOS Supabase connection for website app mode (Phase 1).
model WebsiteSupabaseConnection {
  id        String  @id @default(uuid())
  websiteId String  @unique
  Website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  projectUrl              String
  publishableKeyEncrypted String @db.Text
  secretKeyEncrypted      String @db.Text
  lastTestedAt            DateTime?
  lastTestStatus          String?
  lastTestMessage         String? @db.Text
  schemaVersion           String?
  schemaSql               String?  @db.Text
  connectedAt             DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

/// Named environment variables for invoke runtime (STRIPE_SECRET_KEY, etc.) — user-managed in dashboard.
model WebsiteSecret {
  id        String  @id @default(uuid())
  websiteId String
  Website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  /// UPPER_SNAKE_CASE key, e.g. STRIPE_SECRET_KEY
  name           String
  description    String?
  valueEncrypted String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([websiteId, name])
  @@index([websiteId])
}

enum WEBSITE_CUSTOM_PAGE_SOURCE {
  AGENT
  IMPORT
  USER
}

/// App/admin custom pages — not opened in visual builder (Phase 1 model; routing in Phase 4).
model WebsiteCustomPage {
  id        String  @id @default(uuid())
  websiteId String
  Website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  path     String
  title    String
  document Json
  meta     Json?
  source   WEBSITE_CUSTOM_PAGE_SOURCE @default(AGENT)
  /// Opt-in for /sitemap.xml — custom app pages default off.
  includeInSitemap Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([websiteId, path])
  @@index([websiteId])
}

/// Configurable invoke actions for website app runtime.
model WebsiteAction {
  id        String  @id @default(uuid())
  websiteId String
  Website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  key     String
  label   String?
  enabled Boolean @default(true)
  config  Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([websiteId, key])
  @@index([websiteId])
}

/// Nested folder within a website — slug segments appear in public URLs.
model WebsiteFolder {
  id        String  @id @default(uuid())
  websiteId String
  Website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  parentId  String?
  Parent    WebsiteFolder?  @relation("WebsiteFolderTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Children  WebsiteFolder[] @relation("WebsiteFolderTree")

  name      String
  slug      String
  sortOrder Int    @default(0)

  pages LandingPage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([websiteId, parentId])
  @@index(parentId)
  @@index([websiteId])
}

enum WEBSITE_GLOBAL_COMPONENT_KIND {
  HEADER
  FOOTER
  CTA
  CUSTOM
}

/// Reusable section scoped to a website — resolved live on all pages.
model WebsiteGlobalComponent {
  id        String   @id @default(uuid())
  websiteId String
  Website   Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  name    String
  kind    WEBSITE_GLOBAL_COMPONENT_KIND @default(CUSTOM)
  /// Full SectionNode JSON (section → rows → columns → elements)
  section Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([websiteId])
}

/// AI-built landing pages (draft/publish, block JSON).
model LandingPage {
  id         String   @id @default(uuid())
  businessId String
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  websiteId String
  Website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  folderId  String?
  Folder    WebsiteFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  title  String
  slug   String
  status LANDING_PAGE_STATUS @default(DRAFT)

  /// Homepage for this website — serves `/` on the connected domain.
  isHomePage    Boolean @default(false)
  /// When false, page is omitted from /sitemap.xml (still reachable if published).
  includeInSitemap Boolean @default(true)
  /// Canonical published path e.g. `/`, `/about`, `/services/service-1`
  publishedPath String?

  blocks Json
  theme  Json

  /// Live snapshot — updated only on publish; public /p/[id] reads this.
  publishedBlocks Json?
  publishedTitle  String?
  publishedSlug   String?
  publishedMetaTitle       String?
  publishedMetaDescription String? @db.Text

  metaTitle       String?
  metaDescription String? @db.Text

  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([websiteId, folderId])
  @@index([websiteId, isHomePage])
  @@index([websiteId, publishedPath])
  @@index([businessId, status])
  @@index([status])
}

/// Business-scoped media library (UploadThing-backed).
model BusinessAsset {
  id         String            @id @default(uuid())
  businessId String
  Business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name             String
  originalFileName String
  fileUrl          String
  fileKey          String
  mimeType         String
  type             BusinessAssetType
  fileSizeBytes    Int               @default(0)

  uploadedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, type, createdAt])
  @@index([businessId])
}

/// Reusable funnel form definitions (fields, webhooks, submissions).
model FunnelForm {
  id                 String   @id @default(uuid())
  businessId         String
  Business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name               String
  isActive           Boolean  @default(true)
  externalWebhookUrl String?  @db.Text
  webhookToken       String   @unique

  fields      FunnelFormField[]
  submissions FunnelFormSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, name])
  @@index([businessId])
}

model FunnelFormField {
  id     String     @id @default(uuid())
  formId String
  Form   FunnelForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  key         String
  label       String
  type        FUNNEL_FORM_FIELD_TYPE
  required    Boolean @default(false)
  placeholder String?
  sortOrder   Int     @default(0)

  @@unique([formId, key])
  @@index([formId])
}

model FunnelFormSubmission {
  id         String     @id @default(uuid())
  formId     String
  Form       FunnelForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  businessId String

  landingPageId String?
  data          Json
  leadId        String?
  Lead          Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  webhookStatus FUNNEL_WEBHOOK_STATUS @default(PENDING)
  webhookError  String?               @db.Text

  createdAt DateTime @default(now())

  @@index([formId, createdAt])
  @@index([businessId, createdAt])
}

/// Per-business Gmail or Outlook mailbox for review request emails.
model BusinessMailConnection {
  id         String               @id @default(uuid())
  businessId String               @unique
  Business   Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)

